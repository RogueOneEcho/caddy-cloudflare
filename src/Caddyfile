{
  admin off
  acme_dns cloudflare {file./run/secrets/cloudflare_api_token}
  email {env.TLS_EMAIL}
}

:80, :443 {
  templates
  header Content-Type text/plain
  respond /healthcheck 200 {
    body <<EOF
    Hello {{.RemoteIP}},
    Everything is fine.
    EOF
    close
  }
  respond 421 {
    body <<EOF
    Hello {{.RemoteIP}},
    Unfortunately we couldn't find a match for {{.Host}}.
    EOF
    close
  }
}
